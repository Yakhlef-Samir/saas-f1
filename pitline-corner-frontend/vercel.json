{
  "version": 2,
  "name": "pitline-corner-frontend",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_BASE_URL": "https://pitline-corner-backend.onrender.com/api/v1"
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "regions": ["iad1"]
}
