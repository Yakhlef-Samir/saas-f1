{
  "version": 2,
  "name": "pitline-corner-frontend",
  "framework": "vite",
  "buildCommand": "cd pitline-corner-frontend && npm run build",
  "installCommand": "cd pitline-corner-frontend && npm install",
  "outputDirectory": "pitline-corner-frontend/dist",
  "env": {
    "VITE_API_BASE_URL": "https://pitline-corner-backend.onrender.com"
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "regions": ["iad1"]
}
