figuration incompatible\n  avec les règles F1\n\nModifiez vos paramètres\net réessayez.","fontSize":13,"fontFamily":1,"textAlign":"center","verticalAlign":"top","baseline":143,"containerId":null,"originalText":"Impossible de calculer\nce scénario.\n\nRaison possible:\n• Données de course incomplètes\n  pour ce tour\n• Configuration incompatible\n  avec les règles F1\n\nModifiez vos paramètres\net réessayez.","lineHeight":1.25,"seed":25006,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"locked":false},{"id":"btn-modify","type":"rectangle","x":40,"y":560,"width":310,"height":55,"strokeColor":"#9e9e9e","backgroundColor":"#e0e0e0","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3,"value":6},"seed":25007,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"text-modify"}],"locked":false},{"id":"text-modify","type":"text","x":90,"y":577,"width":210,"height":20,"strokeColor":"#424242","text":"✏️ Modifier paramètres","fontSize":16,"fontFamily":1,"textAlign":"center","verticalAlign":"middle","baseline":14,"containerId":"btn-modify","originalText":"✏️ Modifier paramètres","lineHeight":1.25,"seed":25008,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"locked":false},{"id":"btn-cancel","type":"rectangle","x":40,"y":635,"width":310,"height":50,"strokeColor":"#9e9e9e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3,"value":6},"seed":25009,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"text-cancel"}],"locked":false},{"id":"text-cancel","type":"text","x":90,"y":650,"width":210,"height":20,"strokeColor":"#757575","text":"← Retour Race Rewind","fontSize":14,"fontFamily":1,"textAlign":"center","verticalAlign":"middle","baseline":14,"containerId":"btn-cancel","originalText":"← Retour Race Rewind","lineHeight":1.25,"seed":25010,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"locked":false},{"id":"annotation","type":"text","x":420,"y":300,"width":260,"height":150,"strokeColor":"#d32f2f","text":"📱 MOBILE:\n• Modal plein écran\n• Bordure rouge (erreur)\n• Icône ❌ claire\n• Raisons explicites\n• 2 CTAs empilés:\n  - Modifier (principal)\n  - Retour (secondaire)\n• Touch zones 55px","fontSize":12,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":140,"containerId":null,"originalText":"📱 MOBILE:\n• Modal plein écran\n• Bordure rouge (erreur)\n• Icône ❌ claire\n• Raisons explicites\n• 2 CTAs empilés:\n  - Modifier (principal)\n  - Retour (secondaire)\n• Touch zones 55px","lineHeight":1.25,"seed":25011,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"locked":false}],"appState":{"viewBackgroundColor":"#ffffff"},"files":{}}
